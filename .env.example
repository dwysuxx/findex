# Скопіюйте в .env (він у .gitignore). Змінні оточення мають пріоритет над .env.
INDEX_PATH=index.bin
CORPUS_PATH=data/dota2wiki.jsonl
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# false — читабельні рядки замість JSON (зручніше в терміналі)
LOG_JSON=false
CACHE_SIZE=256
# CORS_ORIGINS=https://my-frontend.example
# Lab 08: ембединги (findex embed); без них semantic/hybrid — 503
EMBEDDINGS_PATH=data/dota2wiki.emb.npz
# FASTEMBED_CACHE_PATH=.cache/fastembed
